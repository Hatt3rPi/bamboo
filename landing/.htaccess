# ============================================================
# BAMBOO SEGUROS · LANDING · .htaccess (Apache / LiteSpeed)
# ============================================================
Options -Indexes +FollowSymLinks
# La home de la landing es home.php (NO index.php). Así, aunque deploy_redesign.php
# deje el index.php del portal en la raíz, "/" sigue sirviendo la landing.
# En /bamboo, /backend, etc. no existe home.php → cae a su index.php normal.
DirectoryIndex home.php index.php
RewriteEngine On

# ---- Canonical: forzar HTTPS + www SOLO en el dominio de producción ----
# (no aplica en subdominios de staging tipo *.customware.cl, así no se rompe el preview)
# Producción por HTTP -> HTTPS www
RewriteCond %{HTTP_HOST} (^|\.)bambooseguros\.cl$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^ https://www.bambooseguros.cl%{REQUEST_URI} [R=301,L]
# Producción apex (sin www) -> www
RewriteCond %{HTTP_HOST} ^bambooseguros\.cl$ [NC]
RewriteRule ^ https://www.bambooseguros.cl%{REQUEST_URI} [R=301,L]

# ---- Sitemap dinámico servido como /sitemap.xml ----
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# ---- 301 desde las URLs antiguas (continuidad SEO) ----
RewriteRule ^index\.php$ / [R=301,L]
RewriteRule ^somos\.php$ /nosotros [R=301,L]
RewriteRule ^seguros\.php$ /#servicios [R=301,L]
RewriteRule ^seguros-vehiculo\.php$ /seguros/auto [R=301,L]
RewriteRule ^seguros-vida\.php$ /seguros/vida [R=301,L]
RewriteRule ^seguros-viaje\.php$ /seguros/viaje [R=301,L]
RewriteRule ^seguros-personales\.php$ /seguros/accidentes-personales [R=301,L]
RewriteRule ^seguros-incendio\.php$ /seguros/incendio-sismo [R=301,L]
RewriteRule ^seguros-responsabilidad-civil\.php$ /seguros/responsabilidad-civil [R=301,L]
RewriteRule ^seguros-garantia\.php$ /seguros/garantia [R=301,L]
RewriteRule ^seguros-transporte\.php$ /seguros/transporte [R=301,L]
RewriteRule ^seguros-credito\.php$ /#servicios [R=301,L]
RewriteRule ^seguros-apv\.php$ /seguros/apv [R=301,L]
RewriteRule ^seguros-ingenieria\.php$ /seguros/ingenieria [R=301,L]
RewriteRule ^seguros-administrador\.php$ /seguros/rc-administradores [R=301,L]

# ---- URLs limpias: redirigir *.php externo a sin extensión ----
# Excluir el portal co-alojado (/backend, /bamboo, /bambooQA, /vendor): quitarles
# el .php rompería sus POST/AJAX (un 301 convierte POST en GET).
RewriteCond %{REQUEST_URI} !^/(backend|bamboo|bambooQA|vendor)/
RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ---- Resolver internamente la versión .php ----
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# ---- Bloquear includes y logs ----
RewriteRule ^(data|partials)/ - [F]
<FilesMatch "(^_|\.(log|md)$)">
  Require all denied
</FilesMatch>

# ---- Cabeceras de seguridad ----
# OJO co-alojado: NO poner Content-Security-Policy aquí. En LiteSpeed el gating
# por env (env=!PORTAL_AREA) NO es fiable y la CSP terminaba aplicándose al portal,
# bloqueando jQuery/Bootstrap/DataTables. La CSP se emite SOLO desde el PHP de la
# landing (partials/head.php) para no tocar nunca al portal.
# HSTS solo en el dominio de producción (gating por Host sí es fiable; verificado).
SetEnvIf Host "(^|\.)bambooseguros\.cl$" PROD_HOST
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=PROD_HOST
</IfModule>

# ---- Compresión ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# ---- Caché de estáticos ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
